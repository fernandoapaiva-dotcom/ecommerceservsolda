# Configurações do Servidor
PORT=5000
NODE_ENV="production"

# Banco de dados (PostgreSQL para produção, SQLite local)
DATABASE_URL="postgresql://username:password@localhost:5432/servsolda?schema=public"

# JWT Autenticação
JWT_SECRET="insira-sua-chave-secreta-jwt-aqui"

# NOTA IMPORTANTE:
# Credenciais da API do Google Gemini, Servidores SMTP (E-mail de alerta),
# e parâmetros do WhatsApp de Vendas não devem mais ser inseridos neste arquivo .env.
# Todas essas credenciais são configuradas dinamicamente após o deploy
# através do Painel Administrativo em: http://localhost:5173/admin/config
